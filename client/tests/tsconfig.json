{
  "//": "不 extends 上层的 client/tsconfig.json：那份 extends 的 temp/tsconfig.cocos.json 需打开 Cocos 才生成，测试不该依赖它。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["*.ts", "../assets/scripts/**/*.ts"]
}
