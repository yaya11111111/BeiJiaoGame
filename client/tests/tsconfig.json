{
  "//": "故意对齐 Cocos 的编译参数（target/lib ES2015、strict、isolatedModules），这样类型错误在本地就能被 npm run typecheck 抓到。不 extends 上层的 client/tsconfig.json：那份 extends 的 temp/tsconfig.cocos.json 需打开 Cocos 才生成，测试不该依赖它。",
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["ES2015"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["*.ts", "../assets/scripts/**/*.ts"],
  // 约定：凡 import 'cc' 的文件一律以 View.ts 结尾（目前只有 LevelView.ts）。
  // 必须排除掉它们 —— Node 下解析不到 'cc' 模块，一旦 LevelView.ts 落地，
  // npm run typecheck 会直接报 TS2307 挂掉。核心逻辑是引擎无关的，
  // 单测只覆盖引擎无关的那部分。
  "exclude": ["../assets/scripts/**/*View.ts"]
}
