{
  "name": "beijiaogame-tests",
  "private": true,
  "type": "module",
  "description": "关卡模块单元测试。故意放在 assets/ 外面 —— Cocos 只扫描 assets/ 下的脚本，放外面就不会被打进小游戏包体。",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:view": "node check-cc-typings.js && tsc --noEmit -p tsconfig.view.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
